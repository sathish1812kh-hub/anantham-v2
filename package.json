{
  "name": "anantham-v2",
  "version": "2.0.1",
  "description": "Anantham V2 — Programmable AI Agent Operating Environment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anantham": "./dist/bin/anantham.js"
  },
  "files": [
    "dist",
    "!dist/release",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "release:build": "node scripts/release-engineering.mjs build",
    "release:audit": "node scripts/release-engineering.mjs audit",
    "release:verify": "node scripts/release-engineering.mjs verify",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-all.ps1",
    "scorecard": "powershell -ExecutionPolicy Bypass -File scripts/certification-scorecard.ps1",
    "sync-state": "powershell -ExecutionPolicy Bypass -File scripts/sync-state.ps1",
    "sync:all": "powershell -ExecutionPolicy Bypass -File scripts/post-task-sync.ps1",
    "sync:codegraph": "powershell -ExecutionPolicy Bypass -File scripts/sync-codegraph.ps1",
    "sync:graphify": "powershell -ExecutionPolicy Bypass -File scripts/sync-graphify.ps1",
    "sync:neo4j": "powershell -ExecutionPolicy Bypass -File scripts/sync-neo4j.ps1",
    "sync:graphiti": "node scripts/sync-graphiti.mjs",
    "sync:git": "powershell -ExecutionPolicy Bypass -File scripts/sync-git.ps1",
    "verdict": "node scripts/generate-verdict.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "runtime",
    "durable",
    "event-sourced",
    "mcp",
    "anantham"
  ],
  "author": "Anantham Engineering Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
